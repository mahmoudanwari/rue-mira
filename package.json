{
  "name": "rue-mira",
  "version": "1.0.0",
  "private": true,
  "description": "RUE MIRA — fictional fashion & accessories demo storefront (portfolio demo, no real purchases).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "npm run images:webp",
    "dev": "next dev",
    "prebuild": "npm run images:webp",
    "build": "next build",
    "serve": "node scripts/serve-out.mjs 4173",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets:check": "node scripts/check-assets.mjs",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run assets:check && npm run build && npm run test:e2e",
    "images:webp": "node scripts/optimize-images.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "^16.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
